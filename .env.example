NODE_ENV=development
PORT=3000
POSTGRES_DB=fangyuanli
POSTGRES_USER=fangyuanli
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fangyuanli:change-me@localhost:5432/fangyuanli
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379
REALTIME_ENABLED=true
ALLOW_TEST_SEED=false
ALLOW_STAGING_SMS=false
LOG_LEVEL=info

# 仅填写开发环境值；真实密钥不得提交。
PHONE_HASH_KEY=
PHONE_ENCRYPTION_KEY=
SMS_CODE_HASH_KEY=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
REQUEST_HASH_KEY=
STAGING_SMS_TEST_CODE=
STAGING_TEST_PHONE_A=
STAGING_TEST_PHONE_B=
AMAP_WEB_SERVICE_KEY=
# 32-byte random key encoded as base64url; encrypts short-lived location tokens.
FANGYUANLI_LOCATION_CONTEXT_KEY=
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_BUCKET=
# Staging/production prefers a CVM-bound CAM role with temporary credentials.
TENCENT_COS_CVM_ROLE=
# Local development fallback only. Do not commit or expose real credentials.
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
# Staging only: public HTTPS hostname for physical-device field acceptance.
STAGING_PUBLIC_HOST=
