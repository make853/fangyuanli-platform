[Unit]
Description=Fangyuanli staging API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/fangyuanli
EnvironmentFile=/srv/fangyuanli/.env
Environment=NODE_ENV=staging
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/pnpm start:api:prod
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
