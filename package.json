{
  "name": "fangyuanli-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "node scripts/verify-layout.mjs",
    "test": "pnpm -r --if-present test",
    "build:api": "pnpm --filter @fangyuanli/api build",
    "db:migrate": "pnpm --filter @fangyuanli/api db:migrate",
    "db:seed:ab": "pnpm --filter @fangyuanli/api db:seed:ab",
    "dev:api": "pnpm --filter @fangyuanli/api dev",
    "start:api": "pnpm --filter @fangyuanli/api start",
    "start:api:prod": "pnpm --filter @fangyuanli/api start:prod"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "0.28.1"
  }
}
